; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SpaceMiner"
run/main_scene="res://scenes/MainView.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=4
boot_splash/image="uid://bbuyyqfu2ukp6"
config/icon="res://assets/icons/icon.png"
boot_splash/minimum_display_time=10

[autoload]

AppState="*res://scripts/autoload/AppState.gd"
State_Manager="*res://scripts/autoload/StateManager.gd"
Audio_Manager="*res://scripts/autoload/AudioManager.gd"
Notification_Manager="*res://scripts/autoload/NotificationManager.gd"
Popup_Manager="*res://scripts/autoload/PopupManager.gd"
Settings_Manager="*res://scripts/autoload/SettingsManager.gd"
Text_Utils="*res://scripts/autoload/TextUtils.gd"
Screen_Manager="*res://scripts/autoload/ScreenManager.gd"
Game_Manager="*res://scripts/autoload/GameManager.gd"
RunManager="*res://scripts/autoload/RunManager.gd"
TooltipManager="*res://scripts/autoload/ToolTipManager.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
ControlsManager="*res://scripts/autoload/ControlsManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

