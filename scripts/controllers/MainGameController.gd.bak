extends StateAwareController
class_name MainGameController

# UI References
@onready var game_background = $GameBackground
@onready var sidebar = $HBoxContainer/Sidebar
@onready var content_area = $HBoxContainer/ContentArea/GameContent
@onready var cutscene_container = $CutsceneLayer/CutsceneContainer

# Game state
var current_section: String = "WILL_AND_WAY"
var game_initialized: bool = false
var introduction_played: bool = false
var game_phase_manager = null

# Cutscene player
var cutscene_player = null

func _ready() -> void:
	print("[MainGameController] Initializing...")
	# Set states where this controller should be visible
	show_in_states = [State.GameState.PLAYING]
	super._ready()
	# Get UI references
	sidebar = $HBoxContainer/Sidebar
	content_area = $HBoxContainer/ContentArea/GameContent
	
	
	
	# Initialize the cutscene player
	_initialize_cutscene_player()
	print("[MainGameController] Ready")

	
func _initialize_cutscene_player() -> void:
	print("[MainGameController] Initializing cutscene player...")
	
	# Instance the CutscenePlayer scene instead of creating a new object
	var cutscene_scene = load("res://scenes/CutscenePlayer.tscn")
	if not cutscene_scene:
		push_error("[MainGameController] Failed to load CutscenePlayer scene")
		
	cutscene_player = cutscene_scene.instantiate()
	cutscene_container.add_child(cutscene_player)
	
	# Set up the cutscene player
	cutscene_player.size_flags_horizontal = Control.SIZE_FILL
	cutscene_player.size_flags_vertical = Control.SIZE_FILL
	cutscene_player.anchors_preset = Control.PRESET_FULL_RECT
	
	# Connect signals
	cutscene_player.cutscene_completed.connect(_on_cutscene_finished)
	
	print("[MainGameController] Cutscene player initialized")

func _initialize_game() -> void:
	print("[MainGameController] Initializing game... DEBUGGING ENABLED")
	# Print the scene tree structure for debugging
	print("[MainGameController] Scene tree structure:")
	_print_scene_tree(self, 0)
	
	# Make the controller visible first
	visible = true
	
	# Make the sidebar visible
	if sidebar:
		sidebar.visible = true
		sidebar.show()
		var sidebar_container = sidebar.get_node_or_null("Container")
		if sidebar_container:
			sidebar_container.visible = true
		else:
			push_error("[MainGameController] Container node not found in sidebar")
	else:
		push_error("[MainGameController] Sidebar not found!")
	
	# Register with Game_Manager for phase updates
	if Engine.has_singleton("Game_Manager"):
		if not Game_Manager.is_connected("phase_changed", _on_game_manager_phase_changed):
			Game_Manager.connect("phase_changed", _on_game_manager_phase_changed)
		print("[MainGameController] Connected to Game_Manager phase_changed signal")
		
		# CRITICAL: Ensure Game_Manager is started
		Game_Manager.game_started = true
		
		# COMPLETELY NEW APPROACH: Load the AssignWorkersPhase scene directly
		print("[MainGameController] COMPLETELY NEW APPROACH: Loading AssignWorkersPhase scene directly")
		var scene_path = "res://scenes/game/phases/AssignWorkersPhase.tscn"
		
		# Make sure content_area is visible
		content_area.visible = true
		content_area.show()
		print("[MainGameController] Content area visibility: ", content_area.visible)
		
		# Get the GameContent reference
		var game_content = content_area
		print("[MainGameController] Game content reference: ", game_content.name)
		
		# Clear any existing phase scenes from game_content
		print("[MainGameController] Clearing game content. Child count: ", game_content.get_child_count())
		for child in game_content.get_children():
			print("[MainGameController] Child in content area: ", child.name, " (type: ", child.get_class(), ")")
			# Only remove children that are not the GamePanel
			if child.name != "GamePanel" and "Phase" in child.name:
				print("[MainGameController] Removing phase scene: ", child.name)
				game_content.remove_child(child)
				child.queue_free()
		
		# Load and instantiate the scene
		print("[MainGameController] Loading scene from path: ", scene_path)
		var scene_resource = load(scene_path)
		if scene_resource:
			print("[MainGameController] Scene resource loaded successfully")
			var phase_scene = scene_resource.instantiate()
			if phase_scene:
				print("[MainGameController] Scene instantiated successfully: ", phase_scene.name)
				
				# Make sure the scene is visible
				phase_scene.visible = true
				phase_scene.show()
				print("[MainGameController] Phase scene visibility: ", phase_scene.visible)
				
				# Set layout properties
				phase_scene.size_flags_horizontal = Control.SIZE_EXPAND_FILL
				phase_scene.size_flags_vertical = Control.SIZE_EXPAND_FILL
				phase_scene.anchors_preset = Control.PRESET_FULL_RECT
				
				# Add to game content
				game_content.add_child(phase_scene)
				print("[MainGameController] Phase scene added to game content")
				
				# Move it to the front
				phase_scene.move_to_front()
				
				# Force layout update
				phase_scene.position = Vector2.ZERO
				phase_scene.size = game_content.size
				phase_scene.offset_right = 0
				phase_scene.offset_bottom = 0
				phase_scene.anchor_right = 1.0
				phase_scene.anchor_bottom = 1.0
				
				# Make sure it's on top of everything
				phase_scene.z_index = 100
				
				# Force immediate update
				phase_scene.force_update_transform()
				game_content.force_update_transform()
				print("[MainGameController] Layout updated")
				
				# Save a reference to the phase scene
				game_phase_manager = phase_scene
				
				# Print the scene tree after adding the phase scene
				print("[MainGameController] Scene tree after adding phase scene:")
				_print_scene_tree(game_content, 0)
				
				# Force visibility one more time
				await get_tree().process_frame
				phase_scene.visible = true
				phase_scene.show()
				print("[MainGameController] Final phase scene visibility: ", phase_scene.visible)
			else:
				push_error("[MainGameController] Failed to instantiate scene")
		else:
			push_error("[MainGameController] Failed to load scene resource")
	else:
		push_error("[MainGameController] Game_Manager singleton not found!")
	
	# The sidebar handles its own buttons
	_connect_sidebar_buttons()
	
	# Wait for one more frame to ensure everything is properly initialized
	await get_tree().process_frame
	
	# Set game as initialized
	game_initialized = true
	
	print("[MainGameController] Game initialization complete")

func _load_game_phase(the_phase:State.GamePhase) -> void:
	print("[MainGameController] Loading game phase: ", State.game_phase_to_string(the_phase))

	# Debug visibility state and node paths
	print("[MainGameController] Current visibility: ", visible)
	print("[MainGameController] Content area path: ", content_area.get_path())
	print("[MainGameController] Content area visibility: ", content_area.visible)
	print("[MainGameController] Content area size: ", content_area.size)
	print("[MainGameController] Content area global position: ", content_area.global_position)
	
	# Make sure the main controller is visible
	visible = true
	
	# Make sure content area is visible
	content_area.visible = true
	content_area.show()
	
	sidebar.visible = true
	sidebar.show()
	var sidebar_container = sidebar.get_node_or_null("Container")
	if sidebar_container:
		sidebar_container.visible = true
		sidebar_container.show()

	# CRITICAL: Clear any existing phase scenes but keep the GamePanel
	print("[MainGameController] Clearing content area. Child count before: ", content_area.get_child_count())
	for child in content_area.get_children():
		if child.name != "GamePanel" and "Phase" in child.name:
			print("[MainGameController] Removing phase scene: ", child.name)
			content_area.remove_child(child)
			child.queue_free()
	
	# Wait for children to be removed
	await get_tree().process_frame
	print("[MainGameController] Child count after: ", content_area.get_child_count())

	# Get the current phase from Game_Manager
	print("[MainGameController] Current phase from GAME_Manager: ", State.game_phase_to_string(the_phase))
	
	# Load the appropriate phase scene based on the current phase
	var phase_scene_path = _get_scene_path_for_phase(the_phase)
	print("[MainGameController] Loading phase scene from path: ", phase_scene_path)
	
	# Check if the scene path is valid
	if phase_scene_path.is_empty():
		push_error("[MainGameController] Invalid phase scene path for phase: " + str(the_phase))
		return
	
	# Load the scene resource
	var scene_resource = load(phase_scene_path)
	if not scene_resource:
		push_error("[MainGameController] Failed to load scene resource: " + phase_scene_path)
		return
	
	# Instantiate the scene
	var phase_scene = scene_resource.instantiate()
	if not phase_scene:
		push_error("[MainGameController] Failed to instantiate scene: " + phase_scene_path)
		return
	
	# Make sure the phase scene is visible
	phase_scene.visible = true
	phase_scene.show()
	print("[MainGameController] Phase scene instantiated: ", phase_scene.name, ", visible: ", phase_scene.visible)
	
	# Add the phase scene to the content area
	game_phase_manager = phase_scene
	content_area.add_child(game_phase_manager)
	print("[MainGameController] Phase scene added to content area")
	
	# Set layout properties
	game_phase_manager.position = Vector2.ZERO
	game_phase_manager.size = content_area.size
	
	# Force immediate update
	game_phase_manager.force_update_transform()
	content_area.force_update_transform()
	
	print("[MainGameController] Phase scene added to content area with layout: ")
	print("  - Visible: ", game_phase_manager.visible)
	print("  - Position: ", game_phase_manager.position)
	print("  - Size: ", game_phase_manager.size)
	print("  - Global position: ", game_phase_manager.global_position)
	
	# Ensure all child nodes in the phase scene are visible
	for child in game_phase_manager.get_children():
		child.visible = true
		child.show()
		print("  - Child node: ", child.name, " visible: ", child.visible)
	
	# Ensure the sidebar is visible and properly positioned
	if sidebar:
		sidebar.visible = true
		var container = sidebar.get_node_or_null("Container")
		if container:
			container.visible = true
		print("[MainGameController] Sidebar and container set visible")
	
	# Phase changes are now handled directly through Game_Manager
	print("[MainGameController] Phase changes will be handled through Game_Manager")
	
	# Connect the Next Phase button in the sidebar
	_connect_sidebar_buttons()
	
	# Wait for the phase scene to be fully initialized
	await get_tree().process_frame
	
	# Force layout update
	game_phase_manager.queue_redraw()
	content_area.queue_redraw()
	queue_redraw()
	
	# Final visibility check
	print("[MainGameController] Final visibility check:")
	print("  - MainGameController: ", visible)
	print("  - Content area: ", content_area.visible)
	print("  - Phase scene: ", game_phase_manager.visible)
	if sidebar:
		print("  - Sidebar: ", sidebar.visible)
	
	print("[MainGameController] Phase scene loaded for phase: " + str(the_phase))


func _play_introduction_cutscene() -> void:
	print("[MainGameController] Playing introduction cutscene...")
	
	# Check if cutscenes are disabled in settings
	if Settings_Manager.get_setting("gameplay", "hide_cutscenes", false):
		print("[MainGameController] Cutscenes disabled in settings, skipping introduction")
		_initialize_game()
		return
	
	# Make sure cutscene player is ready
	if not cutscene_player:
		push_error("[MainGameController] Cutscene player not initialized!")
		_initialize_game()
		return
	
	# Load the introduction cutscene
	var cutscene_path = "res://data/cutscenes/introduction.json"
	var _task = cutscene_player.load_cutscene(cutscene_path)
	
	# Wait for the cutscene to load
	await _task
	
	# Check if cutscene loaded successfully
	if cutscene_player.is_cutscene_loaded():
		# Start playing the cutscene
		cutscene_player.visible = true
		cutscene_player.play()
		introduction_played = true
		print("[MainGameController] Introduction cutscene started")
	else:
		push_error("[MainGameController] Failed to load introduction cutscene")
		# If cutscene fails to load, just initialize the game
		_initialize_game()

# Async wrapper for loading cutscenes
func load_cutscene_async(path: String) -> void:
	var _task = func():
		var success = await cutscene_player.load_cutscene(path)
		
		if success:
			# Start playing the cutscene
			cutscene_player.visible = true
			cutscene_player.play()
			introduction_played = true
			print("[MainGameController] Introduction cutscene started")
		else:
			push_error("[MainGameController] Failed to load introduction cutscene")
			# If cutscene fails to load, just initialize the game
			_initialize_game()
	
	# Execute the task function
	_task.call()
	
func _on_cutscene_finished() -> void:
	print("[MainGameController] Cutscene finished")
	
	# Reset cutscene player state
	if cutscene_player:
		cutscene_player.visible = false
		# Reset any cutscene state variables
		cutscene_player.is_playing = false
		cutscene_player.auto_advance_timer_active = false
		cutscene_player.current_frame = 0
	
	# Wait for one frame to ensure UI updates
	await get_tree().process_frame
	
	# Initialize the game after the introduction cutscene
	if not game_initialized:
		_initialize_game()
	else:
		# If game is already initialized, just make sure it's visible
		visible = true
		if sidebar and sidebar.get_node_or_null("Container"):
			sidebar.get_node("Container").visible = true

# Helper function for debugging scene tree structure
func _print_scene_tree(node: Node, indent: int) -> void:
	var indent_str = ""
	for i in range(indent):
		indent_str += "  "
	print(indent_str + node.name + " (" + node.get_class() + ")")
	if node.visible != null:
		print(indent_str + "  Visible: " + str(node.visible))
	for child in node.get_children():
		_print_scene_tree(child, indent + 1)

# Helper function to convert GamePhase enum to string
func _game_phase_to_string(phase: State.GamePhase) -> String:
	var phase_names = {
		State.GamePhase.ASSIGN_WORKERS: "ASSIGN_WORKERS",
		State.GamePhase.COLLECT_RESOURCES: "COLLECT_RESOURCES",
		State.GamePhase.BUILD_UPGRADE: "BUILD_UPGRADE",
		State.GamePhase.BUY_LAND: "BUY_LAND",
		State.GamePhase.EQUIP_SOLDIERS: "EQUIP_SOLDIERS",
		State.GamePhase.RANDOM_EVENT: "RANDOM_EVENT",
		State.GamePhase.POPULATION_ADJUST: "POPULATION_ADJUST",
		State.GamePhase.TURN_SUMMARY: "TURN_SUMMARY"
	}
	return phase_names.get(phase, "UNKNOWN_PHASE")

# Navigation button handlers
func _on_will_button_pressed() -> void:
	print("[MainGameController] Will and the Way button pressed")
	request_state(State.GameState.PLAYING)


func _connect_sidebar_buttons() -> void:
	print("[MainGameController] Sidebar buttons are handled directly by the sidebar script")
	# The sidebar now handles its own button connections and sends signals directly to Game_Manager


# Handler for phase changes from Game_Manager
func _on_game_manager_phase_changed(new_phase) -> void:
	print("[MainGameController] Game_Manager phase changed to: ", State.game_phase_to_string(new_phase))
	
	# Get the current phase from Game_Manager
	var current_phase = Game_Manager.get_phase()
	print("[MainGameController] Current phase from Game_Manager.get_phase(): ", State.game_phase_to_string(current_phase))
	
	# Load the new phase scene
	_load_game_phase(current_phase)


# Load a phase scene based on the phase from Game_Manager
func _load_phase_scene(phase) -> void:
	print("[MainGameController] Loading phase scene for phase: ", phase)
	
	# CRITICAL: Ensure content_area is properly set up
	print("[MainGameController] Content area check:")
	print("  - Content area exists: ", content_area != null)
	print("  - Content area visible: ", content_area.visible if content_area else "N/A")
	print("  - Content area size: ", content_area.size if content_area else "N/A")
	print("  - Content area global position: ", content_area.global_position if content_area else "N/A")
	
	# Force content area to be visible and properly sized
	if content_area:
		content_area.visible = true
		content_area.show()
		content_area.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		content_area.size_flags_vertical = Control.SIZE_EXPAND_FILL
		content_area.anchors_preset = Control.PRESET_FULL_RECT
	
	# Get the scene path for the current phase
	var scene_path = _get_scene_path_for_phase(phase)
	if scene_path.is_empty():
		push_error("[MainGameController] No scene path found for phase: " + str(phase))
		return
	
	print("[MainGameController] Loading scene from path: ", scene_path)
	
	# Clear any existing content in the content area
	print("[MainGameController] Clearing content area. Child count: ", content_area.get_child_count())
	for child in content_area.get_children():
		print("[MainGameController] Removing child: ", child.name)
		content_area.remove_child(child)
		child.queue_free()
	
	# Wait for children to be removed
	await get_tree().process_frame
	
	# Load and instantiate the new phase scene
	print("[MainGameController] Attempting to load scene resource from: ", scene_path)
	var scene_resource = load(scene_path)
	if not scene_resource:
		push_error("[MainGameController] Failed to load scene: " + scene_path)
		# Try with a direct hardcoded path as fallback
		scene_path = "res://scenes/game/phases/AssignWorkersPhase.tscn"
		print("[MainGameController] Trying fallback path: ", scene_path)
		scene_resource = load(scene_path)
		if not scene_resource:
			push_error("[MainGameController] Fallback path also failed!")
			return
	
	print("[MainGameController] Scene resource loaded successfully: ", scene_resource)
	print("[MainGameController] Instantiating scene...")
	var phase_scene = scene_resource.instantiate()
	if not phase_scene:
		push_error("[MainGameController] Failed to instantiate scene: " + scene_path)
		return
	
	print("[MainGameController] Scene instantiated successfully: ", phase_scene.name)
	print("[MainGameController] Scene class: ", phase_scene.get_class())
	print("[MainGameController] Scene script: ", phase_scene.get_script())
	
	# CRITICAL: Ensure the phase scene is visible before adding it
	phase_scene.visible = true
	phase_scene.show()
	
	# Set the layout properties to ensure it fills the content area
	phase_scene.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	phase_scene.size_flags_vertical = Control.SIZE_EXPAND_FILL
	phase_scene.anchors_preset = Control.PRESET_FULL_RECT
	
	# Add the phase scene to the content area
	print("[MainGameController] Adding phase scene to content area")
	content_area.add_child(phase_scene)
	print("[MainGameController] Phase scene added to content area. New child count: ", content_area.get_child_count())
	
	# CRITICAL: Force layout update with explicit settings
	print("[MainGameController] Setting explicit layout properties")
	phase_scene.position = Vector2.ZERO
	phase_scene.size = content_area.size
	phase_scene.offset_right = 0
	phase_scene.offset_bottom = 0
	phase_scene.anchor_right = 1.0
	phase_scene.anchor_bottom = 1.0
	
	# Force immediate update
	print("[MainGameController] Forcing transform update")
	phase_scene.force_update_transform()
	content_area.force_update_transform()
	
	# CRITICAL: Ensure the scene is in the tree and properly parented
	print("[MainGameController] Verifying scene is in tree: ", phase_scene.is_inside_tree())
	print("[MainGameController] Scene parent: ", phase_scene.get_parent().name if phase_scene.get_parent() else "None")
	
	print("[MainGameController] Phase scene added to content area with layout: ")
	print("  - Visible: ", phase_scene.visible)
	print("  - Position: ", phase_scene.position)
	print("  - Size: ", phase_scene.size)
	print("  - Global position: ", phase_scene.global_position)
	
	# Ensure all child nodes in the phase scene are visible
	for child in phase_scene.get_children():
		child.visible = true
		child.show()
		print("[MainGameController] Child node visible: ", child.name, ": ", child.visible)
	
	# Wait for the phase scene to be fully initialized
	await get_tree().process_frame
	
	# Final visibility check
	print("[MainGameController] Final visibility check:")
	print("  - Content area: ", content_area.visible)
	print("  - Phase scene: ", phase_scene.visible)
	if sidebar:
		print("  - Sidebar: ", sidebar.visible)
	
	print("[MainGameController] Phase scene loaded for phase: " + str(phase))

func _load_game_phase(the_phase) -> void:
	print("[MainGameController] Loading game phase: ", State.game_phase_to_string(the_phase))
	
	# Print all available phases from State.GamePhase
	print("[MainGameController] Available phases in State.GamePhase:")
	for p in State.GamePhase.keys():
		print("  - ", p, ": ", State.GamePhase[p])
	
	# Map State.GamePhase enum values to scene paths
	var phase_scene_paths = {
		-1: "res://scenes/game/phases/TestPhase.tscn", # Special test phase
		State.GamePhase.ASSIGN_WORKERS: "res://scenes/game/phases/AssignWorkersPhase.tscn",
		State.GamePhase.COLLECT_RESOURCES: "res://scenes/game/phases/CollectResourcesPhase.tscn",
		State.GamePhase.BUILD_UPGRADE: "res://scenes/game/phases/BuildUpgradePhase.tscn",
		State.GamePhase.BUY_LAND: "res://scenes/game/phases/BuyLandPhase.tscn",
		State.GamePhase.EQUIP_SOLDIERS: "res://scenes/game/phases/EquipSoldiersPhase.tscn",
		State.GamePhase.RANDOM_EVENT: "res://scenes/game/phases/RandomEventPhase.tscn",
		State.GamePhase.POPULATION_ADJUST: "res://scenes/game/phases/PopulationPhase.tscn",
		State.GamePhase.TURN_SUMMARY: "res://scenes/game/phases/TurnSummaryPhase.tscn"
	}
	
	# Check if the scene path exists
	var path = phase_scene_paths.get(phase, "")
	print("[MainGameController] Scene path for phase ", phase, ": ", path)
	
	# Verify the scene file exists
	if path != "":
		var file = FileAccess.open(path, FileAccess.READ)
		if file:
			print("[MainGameController] Scene file exists: ", path)
			file.close()
		else:
			push_error("[MainGameController] Scene file does not exist: " + path)
			# Fallback to a default phase if the file doesn't exist
			path = "res://scenes/game/phases/AssignWorkersPhase.tscn"
			print("[MainGameController] Falling back to default phase: ", path)
	
	return path


func on_enter_state(state: State.GameState) -> void:
	print("[MainGameController] Entering state: ", State.game_state_to_string(state))
	
	# Make sure we're visible first
	visible = true
	
	# Set current section based on state
	match state:
		State.GameState.PLAYING:
			# Always ensure sidebar is visible in PLAYING state
			sidebar.visible = true
			sidebar.show()
			var sidebar_container = sidebar.get_node_or_null("Container")
			if sidebar_container:
				sidebar_container.visible = true
				sidebar_container.show()
			print("[MainGameController] Forced sidebar visibility in PLAYING state")
	
	# If this is the first time entering a game state and introduction hasn't been played
	if not introduction_played and state == State.GameState.PLAYING:
		_play_introduction_cutscene()
	elif not game_initialized:
		# Initialize the game if not already done
		_initialize_game()
	elif game_initialized:
		# Get the current phase from Game_Manager
		var current_phase = Game_Manager.get_phase() if Engine.has_singleton("Game_Manager") else State.GamePhase.ASSIGN_WORKERS
		
		# Print the current phase information using the helper function
		print("[MainGameController] Game already initialized, loading phase: ", State.game_phase_to_string(current_phase))
		
		# Make sure content area is visible
		content_area.visible = true
		content_area.show()
		print("[MainGameController] Ensured content area visibility on state re-entry")
		
		# Load the game phase
		_load_game_phase(current_phase)
		
			

func on_exit_state(state: State.GameState) -> void:
	print("[MainGameController] Exiting state: ", State.GameState.keys()[state])
	visible = false
