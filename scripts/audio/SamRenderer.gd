# How many PCM samples to generate per SAM "frame" at 22 050 Hz.
# At 8 000 Hz we scale this down proportionally in render().
const SAMPLES_PER_FRAME_22K: int = 50

# Noise source LFSRseed (16-bit Galois LFSR for pseudo-random noise).
var _noise_state: int = 0xACE1

# ---------------------------------------------------------------------------
# One-pole resonator state (two resonators per phoneme, F1 and F2).
# ---------------------------------------------------------------------------
var _r1_prev: float = 0.0  # F1 resonator output (previous sample)
var _r2_prev: float = 0.0  # F2 resonator output


## Render allophone frames to an 8-bit unsigned PCM PackedByteArray.
## frames:  Array of Dictionaries from SamParser.parse()
## voice:   SamVoice profile
func render(frames: Array, voice: SamVoice) -> PackedByteArray:
	var pcm := PackedByteArray()
	_noise_state = 0xACE1
	_r1_prev = 0.0
	_r2_prev = 0.0

	# Samples per frame scaled for the chosen sample rate.
	var spf := int(float(SAMPLES_PER_FRAME_22K) * float(voice.sample_rate) / 22050.0)
	spf = max(spf, 4)

	# Apply speed: fewer frames = faster
	var speed_scale := clampf(voice.speed, 0.25, 4.0)

	for i in range(frames.size()):
		var frame: Dictionary = frames[i]
		var frame_count: int = max(1, int(float(frame["length"]) / speed_scale))
		var is_vowel: bool = frame["vowel"]
		var is_voiced: bool = frame["voiced"]
		var f1: float = float(frame["f1"])
		var f2: float = float(frame["f2"])
		var stress: int = frame["stress"]

		# Modulate formants: mouth biases F2, throat biases F1.
		var mouth_bias := (float(voice.mouth) - 128.0) / 128.0   # -1..+1
		var throat_bias := (float(voice.throat) - 128.0) / 128.0

		var eff_f1 := f1 * (1.0 + throat_bias * 0.4)
		var eff_f2 := f2 * (1.0 + mouth_bias * 0.4)

		# Stress raises F2 slightly and sharpens the buzz.
		var stress_f2_shift := float(stress) * 20.0
		eff_f2 += stress_f2_shift

		# Compute resonator coefficients (simple one-pole IIR).
		var sr := float(voice.sample_rate)
		var a1 := _resonator_coeff(eff_f1, sr)
		var a2 := _resonator_coeff(eff_f2, sr)

		# Pitch: number of samples per glottal pulse.
		# Higher voice.pitch value → longer period → lower pitch.
		var pitch_period := max(4, voice.pitch)

		for _f in range(frame_count):
			var block := _render_frame(
				pitch_period, spf, is_voiced, a1, a2, voice.volume
			)
			for b in block:
				pcm.append(b)

		# Reset resonators at phoneme boundary to avoid smearing.
		_r1_prev = 0.0
		_r2_prev = 0.0

	# Apply crunch (bit-depth reduction)
	if voice.crunch > 0.0:
		pcm = _apply_crunch(pcm, voice.crunch, voice.crunch_bits)

	return pcm


## Render a single frame of spf_samples samples.
## Returns a PackedByteArray of unsigned 8-bit samples.
func _render_frame(
		pitch_period: int,
		spf_samples: int,
		is_voiced: bool,
		coeff_f1: float,
		coeff_f2: float,
		volume: float
) -> PackedByteArray:
	var block := PackedByteArray()
	block.resize(spf_samples)

	var phase := 0  # position within current pitch period

	for s in range(spf_samples):
		var raw: float = 0.0

		if is_voiced:
			# Sawtooth glottal buzz: ramp from +1 to -1 over one pitch period.
			var t := float(phase) / float(pitch_period)
			raw = 1.0 - 2.0 * t   # sawtooth
			phase += 1
			if phase >= pitch_period:
				phase = 0
		else:
			# Unvoiced: shaped noise (LFSR pseudo-random).
			raw = _next_noise() * 0.7

		# F1 resonator (one-pole low-pass-ish)
		var r1 := raw + coeff_f1 * _r1_prev
		_r1_prev = r1

		# F2 resonator (tuned higher)
		var r2 := raw + coeff_f2 * _r2_prev
		_r2_prev = r2

		# Mix the two formants
		var mixed := r1 * 0.6 + r2 * 0.4

		# Scale and clamp
		var scaled := mixed * volume
		var byte_val := int(scaled * 64.0) + 128   # 128 = silence midpoint
		byte_val = clampi(byte_val, 0, 255)
		block[s] = byte_val

	return block


## Compute a one-pole IIR coefficient for frequency f at sample rate sr.
## Larger coefficient → resonance peaks higher at f.
func _resonator_coeff(f: float, sr: float) -> float:
	if f <= 0.0 or sr <= 0.0:
		return 0.0
	# Simple approximation: coeff = exp(-2*pi*bandwidth/sr)
	# We treat bandwidth as f/3 for a moderately sharp resonance.
	var bandwidth := f / 3.0
	var coeff := exp(-2.0 * PI * bandwidth / sr)
	return clampf(coeff, 0.0, 0.98)


## Galois 16-bit LFSR noise source. Returns a float in [-1.0, 1.0].
func _next_noise() -> float:
	# Polynomial: x^16 + x^14 + x^13 + x^11 + 1
	var lsb: int = _noise_state & 1
	_noise_state >>= 1
	if lsb:
		_noise_state ^= 0xB400
	# Map [0, 65535] to [-1, 1]
	return float(_noise_state & 0xFFFF) / 32767.5 - 1.0


## Apply bit-depth reduction (crunch effect) to an 8-bit PCM buffer.
## intensity ∈ [0.0, 1.0]; bits ∈ [2, 8].
func _apply_crunch(pcm: PackedByteArray, intensity: float, bits: int) -> PackedByteArray:
	bits = clampi(bits, 2, 8)
	var levels := 1 << bits              # e.g. 64 for 6-bit
	var step := 256.0 / float(levels)    # bucket width

	var out := PackedByteArray()
	out.resize(pcm.size())

	for i in range(pcm.size()):
		var original := float(pcm[i])
		var quantised := floor(original / step) * step + step * 0.5
		# Blend between original and quantised based on intensity
		var blended := original + (quantised - original) * intensity
		out[i] = clampi(int(blended), 0, 255)

	return out
