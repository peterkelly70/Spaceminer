[node name="StoryText" type="RichTextLabel" parent="MarginContainer/VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 22
bbcode_enabled = true
text = "In the elder days, before the breaking of the high roads and the dimming of the forge-stars, there stood a city hewn from the bones of the world — [color=#ddb222]Ironhaven[/color], greatest of the deep strongholds. Its halls rang with hammers, its vaults glittered with gold and crystal, and its name was spoken with awe by dwarf, elf, and man alike.

But pride is a double-edged axe. In their hunger for the hidden fire, the kings of Ironhaven delved deep — deeper than wisdom allowed, and deeper still. What they found none can say, for Ironhaven did not fall in battle, nor with a cry of warhorns. It was swallowed — by stone, by silence, and by time.

The clans mourned. The line of kings was broken. And the city passed into legend, its name sung only in the old songs.

[b]Until now.[/b]

A map has come to light — old, brittle, marked with runes not spoken in an age. It speaks of sealed gates, of buried forges, and of a crown yet unclaimed. The southern clans, long without a throne, have stirred. They have cast their votes in the ancient way, and chosen [b]you[/b], last scion of the Ironhaven line.

It falls to you to gather your kin, brave the long dark, and rekindle the forges.
To raise halls from ruin.
To bind clan to purpose.
To restore what was lost.

[color=#ddb222]Ironhaven must rise again — not as it was, but as it was always meant to be.[/color]"
fit_content = true

[node name="ContinueButton" type="Button" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(200, 50)
