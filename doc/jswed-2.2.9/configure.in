dnl Process this file with autoconf to produce a configure script.
AC_INIT()
AC_CONFIG_AUX_DIR(config)
VERSION=2.2.9
UPDATED='27 January 2006'
AM_INIT_AUTOMAKE(jswed, $VERSION)
AM_CONFIG_HEADER(config.h)
AC_CANONICAL_HOST
AC_CYGWIN
AC_MINGW32
AC_EXEEXT

AC_ARG_WITH(tmpdir,
[  --with-tmpdir=dir       Set the directory to use for temporary files [default=/tmp]],
	tmpdir=$withval,tmpdir=/tmp)

AC_ARG_ENABLE(debug,
[  --enable-debug          Turn on internal debug messages [default=no]],
	enable_debug=yes, enable_debug=no )

dnl Checks for programs.
AC_PROG_INSTALL
AC_PROG_CXX
AC_PROG_CC
AM_PROG_LIBTOOL
AC_PROG_MAKE_SET

if test "$GCC" = yes
then
  CFLAGS="${CFLAGS} -Wall -D_GNU_SOURCE"
fi

CPPFLAGS="$CPPFLAGS -DJSW_LIB_DIR=${datadir}/jswed"

if test "$enable_debug" = "yes"
then
  CPPFLAGS="$CPPFLAGS -DDEBUGGING"
fi

if test "$CYGWIN" = "yes"
then
  SDL_CFLAGS=`sdl-config --cflags`
  SDL_LIBS=`sdl-config --libs`
  LIBS="$LIBS -lz -lSDLmain"
  ZLIB="-lz"
else
  if test "$MINGW32" = "yes"
  then
    SDL_CFLAGS=`sdl-config --cflags`
    SDL_LIBS=`sdl-config --libs`
    LIBS="$LIBS -lz -lSDLmain"
    ZLIB="-lz"
  else
    SDL_VERSION=1.0.8
    AM_PATH_SDL($SDL_VERSION,
            :,
            AC_MSG_ERROR([*** SDL version $SDL_VERSION not found!])
)
    ZLIB=""
  fi
fi

CPPFLAGS="$CPPFLAGS $SDL_CFLAGS -DTMPDIR=${tmpdir} -DJSW_LIB_DIR=${datadir}/jswed"
LIBS="$LIBS $SDL_LIBS"

dnl Checks for libraries.
AC_CHECK_LIB(png, png_init_io, , [echo "libpng not found - aborting"; exit 1])
LIBS="$LIBS -lpng $ZLIB"
AC_CHECK_LIB(SDL_image, ReadImage, [echo "libSDL_Image not found - aborting"; exit 1])
LIBS="-lSDL_image $LIBS"

dnl Checks for header files.
AC_HEADER_DIRENT
AC_HEADER_STDC
AC_CHECK_HEADERS(limits.h unistd.h fcntl.h windows.h pwd.h)
AC_CHECK_HEADERS(sys/types.h sys/stat.h sys/wait.h)
AC_CHECK_FUNCS(vsnprintf)
dnl Checks for typedefs, structures, and compiler characteristics.

dnl Checks for library functions.

AC_C_CONST
AC_TYPE_SIZE_T
AC_STRUCT_ST_RDEV


AC_OUTPUT(Makefile share/Makefile)
